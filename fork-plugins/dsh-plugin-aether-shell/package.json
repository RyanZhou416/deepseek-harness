{
  "name": "@ryanzhou416/dsh-plugin-aether-shell",
  "version": "0.1.0-dsh021rc2.4",
  "private": true,
  "type": "module",
  "description": "Optional native AetherShell queries, persistent interpreter sessions and background jobs for DSH agents",
  "license": "MIT",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "exports": { ".": "./lib/lifecycle.mjs", "./package.json": "./package.json" },
