{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "jsx": "react-jsx",
    "lib": [
      "es2024",
      "dom"
    ],
    "strict": true,
    "noImplicitAny": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "declaration": true,
    "stripInternal": true,
    "outDir": "lib",
    "rootDir": "src",
    "types": [
      "node"
    ],
    "paths": {
      "@deepseek-ai/dsh-llm": [
        "../../packages/llm/llm/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-attachment": [
        "../../packages/attachment/attachment/lib/types/index.d.ts"
      ],
      "@deepseek-ai/dsh-attachment-local": [
        "../../packages/attachment/attachment-local/lib/types/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
